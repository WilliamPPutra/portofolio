ik\r\n-Gunting Kuku\r\n-Bendera Kuning\r\n\r\nKeyword : \r\npaket kain kafan ekonomis\r\npaket pemulasaraan jenazah ekonomis\r\nkain kafan lengkap murah\r\npaket kafan jenazah siap pakai\r\nperlengkapan jenazah muslim\r\npaket pemulasaran jenazah masjid\r\nkain kafan untuk sedekah\r\npaket kafan untuk stok masjid\r\nbeli paket kain kafan\r\npaket kafan murah berkualitas\r\npaket pemulasaraan jenazah lengkap\r\npaket kain kafan ready stock\r\npengadaan paket jenazah\r\npaket kafan masjid ekonomis","category_id":2,"brand_id":1,"is_active":true,"created_at":"2026-05-04T08:07:31.000000Z","updated_at":"2026-06-09T08:09:39.000000Z","deleted_at":null,"images":[{"id":18,"product_id":1,"url":"products/dlQGDay415vKoxIGUElJijCIoFu2skot9R1Ure0d.png","order":0,"is_primary":true,"created_at":"2026-05-11T04:03:00.000000Z","updated_at":"2026-05-11T04:03:00.000000Z"},{"id":19,"product_id":1,"url":"products/bfEzKfkn4Qth7GV7QywrgnKxYVR4EA7l9IJdJ8z2.png","order":1,"is_primary":false,"created_at":"2026-05-11T04:03:00.000000Z","updated_at":"2026-05-11T04:03:00.000000Z"},{"id":20,"product_id":1,"url":"products/p2ltM9f0D9kt0xznNAteI6fodNvqr2UREeQwc2ed.png","order":2,"is_primary":false,"created_at":"2026-05-11T04:03:00.000000Z","updated_at":"2026-05-11T04:03:00.000000Z"},{"id":21,"product_id":1,"url":"products/Mp9hNcHnun7JBMqHriGmCljFYRvSA9WWskgOeVhn.png","order":3,"is_primary":false,"created_at":"2026-05-11T04:03:00.000000Z","updated_at":"2026-05-11T04:03:00.000000Z"},{"id":22,"product_id":1,"url":"products/LttunDyOw47D6ThY0wNAbwMIvmi6HtF6i6sBakS4.png","order":4,"is_primary":false,"created_at":"2026-05-11T04:03:00.000000Z","updated_at":"2026-05-11T04:03:00.000000Z"},{"id":23,"product_id":1,"url":"products/1vfwr5IZyP9bz07TjIPj1436UozjOxYNx3bb2oYW.png","order":5,"is_primary":false,"created_at":"2026-05-11T04:03:00.000000Z","updated_at":"2026-05-11T04:03:00.000000Z"},{"id":24,"product_id":1,"url":"products/TfbCdrri9zhnBh1qaFcpDKxbbCtUFnPJOOq9frsv.png","order":6,"is_primary":false,"created_at"